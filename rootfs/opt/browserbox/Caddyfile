{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	@protected not path /healthz
	basic_auth @protected {
		{$BBX_USER} {$BBX_HASH}
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:8081
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8081
	}
	# Chrome DevTools Protocol. Chromium only accepts a localhost Host header and
	# echoes it in webSocketDebuggerUrl, so clients swap in their own host.
	@cdp path /json /json/* /devtools/*
	handle @cdp {
		reverse_proxy 127.0.0.1:9222 {
			header_up Host 127.0.0.1:9222
		}
	}
	handle / {
		redir * /vnc.html?autoconnect=1&resize=scale&reconnect=1 302
	}
	handle {
		reverse_proxy 127.0.0.1:6080
	}
}
